# Copy this file to .env and fill in real values. Never commit the real .env file.
PG_HOST=localhost
PG_PORT=5432
PG_DB=student_analytics
PG_USER=postgres
PG_PASSWORD=change_me

# Local path to raw UCI dataset files (student-mat.csv / student-por.csv)
RAW_DATA_DIR=./data/raw
STAGING_DATA_DIR=./data/staging
CLEANED_DATA_DIR=./data/cleaned
ANALYTICAL_DATA_DIR=./data/analytical
LOG_DIR=./data/logs

# UCI dataset download URLs (public, no auth required)
UCI_MAT_URL=https://archive.ics.uci.edu/ml/machine-learning-databases/00320/student.zip
